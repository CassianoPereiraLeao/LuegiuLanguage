use target -> single

extract -> "types.lh"
extract -> "parser.lh"
extract -> "common.lh"
extract -> "diagnostic.lh"
extract -> "string_helper.lh"

preprocess SCOPE_TABLE_INIT_SIZE -> 8
preprocess DEFAULT_INIT_SIZE -> 32
preprocess TABLE_LOAD_FACTOR -> 0.8

funcpreprocess TABLE_PROTOTYPE(T, ALIAS, SUFFIX) ->
    #{T}* #{ALIAS}_table_#{SUFFIX}(View name);
<-

structpreprocess TABLE_DEF(T) ->
    newtype data {
        #{T}Entry** items;
        uint64 count;
        uint64 capacity;
    } #{T}Table
<-

structpreprocess CHANGED_TABLE_DEF(T) ->
    newtype data {
        #{T}Entry** items;
        uint64 count;
        uint64 capacity;
    } 
<-

newtype data EnumConstEntry EnumConstEntry;
newtype data TypeEntry TypeEntry;
newtype data FuncEntry FuncEntry;
newtype data SymbolEntry SymbolEntry;
newtype data GlobalEntry GlobalEntry;
newtype data LabelEntry LabelEntry;
newtype data Scope Scope;

newtype enum {
    OK,
    ERROR,
    WARNING
} CompactResult;

newtype enum {
    NEW, MERGED,
    REDEFINED, TYPE_MISMATCH
} GlobalDeclStatus;

newtype enum {
    ALIAS,
    AGGREGATE,
    ENUM
} TypeEntryKind;

enum { 
    INTR_VDIFF16 = 1, INTR_VEQ64, INTR_CTZ,
    INTR_VCOPY16X2, INTR_VCOPY32X2, INTR_VCOPY64, 
    INTR_REPMOVSB, INTR_VNULL16, INTR_VNULL64,
    INTR_VFILL16X2, INTR_VFILL32X2, INTR_VFILL64, 
    INTR_REPSTOSB,
    INTR_VFIND16, INTR_VFIND64, INTR_CLZ,
    INTR_MEM_BARRIER, INTR_VFILL64X2, INTR_VFINDW16,
    INTR_VCMPZ16, INTR_VFINDZ16, INTR_VANYZ64,
    INTR_UMULH, INTR_FPBITS, INTR_BITSD, 
    INTR_BITSF
};

newtype data {
    big value;
    bool _big;
} ConstInt;

newtype data {
    bool know;
    LiteralKind lkind;
    ConstInt int;
    double f;
} ConstValue;

newtype data {
    View name;
    Typecheck type;
    uint64 offset;
    uint64 size;
} FieldInfo;

newtype data {
    const char* name;
    int32 id;
    int32 argc;
    TokenType ret;
} IntrinInfo;

data AggregateDef {
    NodeKinds kind;
    FieldInfo* fields;
    uint64 count;
    uint64 size;
    uint64 align;
    bool complete;
    bool flexible;
};

data EnumConstEntry {
    View name;
    data EnumConstEntry* next;
    View enum_name;
    big value;
    Node* decl_node;
};

newtype data {
    LiteralKind kind;
    View name;
    uint64 value;
} EnumMemberInfo;

newtype data {
    EnumMemberInfo* members;
    uint64 member_count;
} EnumDef;

data TypeEntry {
    View name;
    TypeEntryKind kind;
    coperate {
        Typecheck alias;
        AggregateDef aggregate;
        EnumDef enumdef;
    } type;

    data TypeEntry* next;
};

newtype data {
    Typecheck call_type;
    Typecheck* param_types;
    uint64 param_count;
    bool variadic;
} FunctionSignature;

data FuncEntry {
    View name;
    FunctionSignature signature;
    bool _static;
    bool _extern;
    bool _inline;
    bool _pending;
    bool _builtin;
    bool _kernel;
    bool has_body;
    uint64 call_count;
    Node* first_call;
    Node* decl_node;
    const char* file;
    data FuncEntry* next;
};

data SymbolEntry {
    View name;
    Typecheck type;
    ConstValue cval;
    data SymbolEntry* next;
};

data GlobalEntry {
    View name;
    Typecheck type;
    bool _static;
    bool _extern;
    bool _const;
    bool has_init;
    ConstValue cval;
    Node* decl_node;
    data GlobalEntry* next;
};

newtype data {
    InitItem* items;
    uint64 count;
    uint64 capacity;
    uint64 payload;
    uint64 high;
    bool unsorted;
} InitBuilder;

data LabelEntry {
    View name;
    Node* first_jump;
    bool _defined;
    Node* decl_node;
    data LabelEntry* next;
};

newtype data {
    View name;
    Typecheck type;
} Symbol;

TABLE_DEF(EnumConst);
TABLE_DEF(Func);
TABLE_DEF(Type);
TABLE_DEF(Global);
TABLE_DEF(Symbol);
TABLE_DEF(Label);
CHANGED_TABLE_DEF(Type) NewTypeTable;

data Scope {
    SymbolTable symbols;
    data Scope* next;
};

newtype data {
    Arena* arena;
    DiagnosticContext* ctx;
    Scope* current_scope;
    Typecheck current_call_type;
    bool in_function;
    bool in_loop;
    bool in_variadic;
    bool no_fold;
    Node* entry_function;
    bool kernel_mode;
} CheckContext;

CheckContext create_checkctx(Arena *arena, DiagnosticContext *ctx);
void check_program(CheckContext *ctx, Node *program);
void typecheck_finalize(CheckContext *ctx, bool require_entry);
void typecheck_session_init(Arena *arena);
void typecheck_globals_init(Arena *arena);
void typecheck_dump_functions(link out);

Scope* scope_push(Arena *arena, Scope *parent);

SymbolEntry* scope_insert(Arena *arena, Scope *scope, View name, Typecheck type);
SymbolEntry* scope_lookup(Scope *scope, View name);
SymbolEntry* scope_lookup_chain(Scope *scope, View name);

TABLE_PROTOTYPE(FuncEntry, function, insert)
TABLE_PROTOTYPE(FuncEntry, function, lookup)
TABLE_PROTOTYPE(TypeEntry, type, insert)
TABLE_PROTOTYPE(TypeEntry, type, lookup)
TABLE_PROTOTYPE(TypeEntry, newtype, insert)
TABLE_PROTOTYPE(TypeEntry, newtype, lookup)
TABLE_PROTOTYPE(GlobalEntry, global, lookup)
TABLE_PROTOTYPE(EnumConstEntry, enum_const, declare)
TABLE_PROTOTYPE(EnumConstEntry, enum_const, lookup)

LabelEntry* label_declare(View name, Node *declare);
LabelEntry* label_reference(View name, Node *_use);
void label_table_reset(void);
void typecheck_set_file(const char* filename);

GlobalEntry* global_var_decl(View name, Typecheck type, Node *node, bool _static, bool _extern, bool has_init, GlobalDeclStatus *status);
bool resolve_variable(Scope *scope, View name, Typecheck *out);
uint64 func_count(void);
FuncEntry* func_item(uint64 i);
bool type_equals(Typecheck first, Typecheck second);
char* format_signature(char* buffer, uint64 size, View name, const FunctionSignature *signature);

bool decode_char_literal(View v, uint64 *out);
bool isintegerbase(TokenType type);
bool isunsignedbase(TokenType type);
bool is_numeric_constant(Node *node);
bool fold_const_binary(CheckContext *ctx, Node *node, Typecheck result);
bool const_eval(Node *node, ConstInt *out);
bool is_prim_scalar(Typecheck type);
int32 integerwidth(TokenType type);
const char* tname(Typecheck t);
void const_wrap(ConstInt *c, Typecheck type);
uint64 type_size_scalar(Typecheck type);
uint64 type_align(Typecheck type);
uint64 unescaped_length(View raw);
