extract -> "io.lh"

static char*  mem_dst;
static uint32 mem_cap;
static int32  mem_mode;

static char write_buf[WRITE_BUF_SIZE];
static uint32 write_len;
static int32 write_total;

static int32 f_flags;
static int32 f_width;
static int32 f_prec;
static int32 f_bits;

static void write_flush(link file) {
    if(!mem_mode && write_len > 0) {
        WINSIZE done = 0;
        WriteFile(file, write_buf, (WINSIZE)write_len, &done, 0);
        write_len = 0;
    }
}

static void write_put(link file, char c) {
    if(mem_mode) {
        if(mem_cap > 0 && (uint32)(write_total + 1) < mem_cap) {
            mem_dst[write_total] = c;
        }
        write_total++;
    } else {
        if(write_len >= WRITE_BUF_SIZE) {
            write_flush(file);
        }

        write_buf[write_len] = c;
        write_len++;
        write_total++;
    }
}
static void write_repeat(link file, char c, int32 count) {
    while(count > 0) {
        write_put(file, c);
        count--;
    }
}

static void write_bytes(link file, char* s, int32 n) {
    for(int32 i = 0; i < n; ++i) {
        write_put(file, s[i]);
    }
}

static void write_field(link file, char* s, int32 n) {
    int32 pad = 0;
    if(f_width > n) {
        pad = f_width - n;
    }

    if(!(f_flags & FL_LEFT)) {
        write_repeat(file, ' ', pad);
    }

    write_bytes(file, s, n);

    if(f_flags & FL_LEFT) {
        write_repeat(file, ' ', pad);
    }
}

static int32 digits_of(char* buf, uint64 value, uint64 base, int32 upper) {
    int32 pos = 72;

    if(value == 0) {
        pos--;
        buf[pos] = '0';
    }

    while(value != 0) {
        uint64 d = value % base;
        value = value / base;
        pos--;

        if(d < 10) {
            buf[pos] = (char)('0' + d);
        } else if(upper) {
            buf[pos] = (char)('A' + d - 10);
        } else {
            buf[pos] = (char)('a' + d - 10);
        }
    }

    call pos;
}

static int64 narrow_signed(int64 raw) {
    int64 v = raw;
    if(f_bits == 8) {
        v = (int64)(int8)raw;
    } else if(f_bits == 16) {
        v = (int64)(int16)raw;
    } else if(f_bits == 32) {
        v = (int64)(int32)raw;
    }
    call v;
}

static uint64 narrow_unsigned(uint64 raw) {
    uint64 v = raw;
    if(f_bits == 8) {
        v = (uint64)(uint8)raw;
    } else if(f_bits == 16) {
        v = (uint64)(uint16)raw;
    } else if(f_bits == 32) {
        v = (uint64)(uint32)raw;
    }
    call v;
}

static void write_number(link file, char* digits, int32 ndig, char* prefix) {
    int32 plen = (int32)strlen(prefix);
    int32 zeros = 0;
    if(f_prec > ndig) {
        zeros = f_prec - ndig;
    }

    int32 total = plen + zeros + ndig;
    int32 pad = 0;
    if(f_width > total) {
        pad = f_width - total;
    }

    int32 left = f_flags & FL_LEFT;
    if(!left && (f_flags & FL_ZERO) && f_prec < 0) {
        zeros = zeros + pad;
        pad = 0;
    }

    if(!left) {
        write_repeat(file, ' ', pad);
    }

    write_bytes(file, prefix, plen);
    write_repeat(file, '0', zeros);
    write_bytes(file, digits, ndig);

    if(left) {
        write_repeat(file, ' ', pad);
    }
}

static void write_double(link file, double v) {
    char digits[72];
    char num[48];
    char prefix[2];

    int32 prec = f_prec;
    if(prec < 0) {
        prec = 6;
    }
    if(prec > 17) {
        prec = 17;
    }

    char sign = 0;
    if(v < 0.0) {
        sign = '-';
        v = -v;
    } else if(f_flags & FL_PLUS) {
        sign = '+';
    } else if(f_flags & FL_SPACE) {
        sign = ' ';
    }

    prefix[0] = sign;
    prefix[1] = 0;

    if(v != v) {
        write_field(file, "nan", 3);
    } else if(v - v != 0.0) {
        if(sign == '-') {
            write_field(file, "-inf", 4);
        } else {
            write_field(file, "inf", 3);
        }
    } else if(v >= 9000000000000000000.0) {
        write_field(file, "(overflow)", 10);
    } else {
        double r = 0.5;
        for(int32 i = 0; i < prec; ++i) {
            r = r / 10.0;
        }
        v = v + r;

        uint64 ip = (uint64)v;
        double fp = v - (double)ip;

        int32 first = digits_of(digits, ip, 10, 0);
        int32 len = 0;
        for(int32 k = first; k < 72; ++k) {
            num[len] = digits[k];
            len++;
        }

        if(prec > 0 || (f_flags & FL_ALT)) {
            num[len] = '.';
            len++;
        }

        for(int32 j = 0; j < prec; ++j) {
            fp = fp * 10.0;
            int32 d = (int32)fp;
            num[len] = (char)('0' + d);
            len++;
            fp = fp - (double)d;
        }

        f_prec = -1;
        write_number(file, num, len, prefix);
    }
}

static int32 format_core(link file, char* fmt, va_list ap) {
    char digits[72];
    char prefix[4];

    write_len = 0;
    write_total = 0;

    while(*fmt != 0) {
        char c = *fmt;
        fmt++;

        if(c != '%') {
            write_put(file, c);
            continue;
        }

        f_flags = 0;
        f_width = 0;
        f_prec = -1;
        f_bits = 32;

        int32 more = 1;
        while(more) {
            char fc = *fmt;
            if(fc == '-') {
                f_flags |= FL_LEFT;
            } else if(fc == '0') {
                f_flags |= FL_ZERO;
            } else if(fc == '+') {
                f_flags |= FL_PLUS;
            } else if(fc == ' ') {
                f_flags |= FL_SPACE;
            } else if(fc == '#') {
                f_flags |= FL_ALT;
            } else {
                more = 0;
            }

            if(more) {
                fmt++;
            }
        }

        if(*fmt == '*') {
            f_width = (int32)va_arg(ap, int64);
            fmt++;
            if(f_width < 0) {
                f_flags |= FL_LEFT;
                f_width = -f_width;
            }
        } else {
            while(*fmt >= '0' && *fmt <= '9') {
                f_width = f_width * 10 + (int32)(*fmt - '0');
                fmt++;
            }
        }

        if(*fmt == '.') {
            fmt++;
            f_prec = 0;
            if(*fmt == '*') {
                f_prec = (int32)va_arg(ap, int64);
                fmt++;
            } else {
                while(*fmt >= '0' && *fmt <= '9') {
                    f_prec = f_prec * 10 + (int32)(*fmt - '0');
                    fmt++;
                }
            }
        }

        more = 1;
        while(more) {
            char lc = *fmt;
            if(lc == 'h') {
                if(f_bits == 16) {
                    f_bits = 8;
                } else {
                    f_bits = 16;
                }
            } else if(lc == 'l' || lc == 'z' || lc == 'j' || lc == 't') {
                f_bits = 64;
            } else {
                more = 0;
            }

            if(more) {
                fmt++;
            }
        }

        char conv = *fmt;
        if(conv == 0) {
            break;
        }
        fmt++;

        if(conv == '%') {
            write_put(file, '%');
        } else if(conv == 'c') {
            char ch = (char)va_arg(ap, int64);
            write_field(file, &ch, 1);
        } else if(conv == 's') {
            char* s = va_arg(ap, char*);
            if(s == (char*)0) {
                s = "(null)";
            }

            int32 n = (int32)strlen(s);
            if(f_prec >= 0 && f_prec < n) {
                n = f_prec;
            }
            write_field(file, s, n);
        } else if(conv == 'd' || conv == 'i') {
            int64 sv = narrow_signed(va_arg(ap, int64));
            uint64 mag = (uint64)sv;

            prefix[0] = 0;
            if(sv < 0) {
                mag = (uint64)(-sv);
                prefix[0] = '-';
            } else if(f_flags & FL_PLUS) {
                prefix[0] = '+';
            } else if(f_flags & FL_SPACE) {
                prefix[0] = ' ';
            }
            prefix[1] = 0;

            int32 first = digits_of(digits, mag, 10, 0);
            write_number(file, digits + first, 72 - first, prefix);
        } else if(conv == 'u' || conv == 'x' || conv == 'X' || conv == 'o' || conv == 'b' || conv == 'p') {
            uint64 uv = (uint64)va_arg(ap, int64);
            if(conv != 'p') {
                uv = narrow_unsigned(uv);
            }

            uint64 base = 10;
            int32 upper = 0;
            if(conv == 'x' || conv == 'p') {
                base = 16;
            } else if(conv == 'X') {
                base = 16;
                upper = 1;
            } else if(conv == 'o') {
                base = 8;
            } else if(conv == 'b') {
                base = 2;
            }

            prefix[0] = 0;
            prefix[1] = 0;
            prefix[2] = 0;
            if(conv == 'p' || ((conv == 'x' || conv == 'X') && (f_flags & FL_ALT) && uv != 0)) {
                prefix[0] = '0';
                if(upper) {
                    prefix[1] = 'X';
                } else {
                    prefix[1] = 'x';
                }
            }

            int32 first = digits_of(digits, uv, base, upper);
            write_number(file, digits + first, 72 - first, prefix);
        } else if(conv == 'f' || conv == 'F') {
            write_double(file, va_arg(ap, double));
        } else {
            write_put(file, '%');
            write_put(file, conv);
        }
    }

    write_flush(file);
    call write_total;
}

int32 vfwrite(link file, char* fmt, va_list ap) {
    mem_mode = 0;
    call format_core(file, fmt, ap);
}

int32 vwrite(link file, char* fmt, va_list ap) {
    call vfwrite(file, fmt, ap);
}

int32 fwrite(link file, char* fmt, ...) {
    va_list ap;
    va_start(ap, fmt);
    int32 n = vwrite(file, fmt, ap);
    va_end(ap);
    call n;
}

int32 fwritec(char c, link file) {
    call fwrite(file, "%c", c);
}

int32 write(char* fmt, ...) {
    va_list ap;
    va_start(ap, fmt);
    int32 n = vwrite(stdout, fmt, ap);
    va_end(ap);
    call n;
}

int32 vsnwrite(char* buf, uint64 size, char* fmt, va_list ap) {
    mem_mode = 1;
    mem_dst = buf;

    if(size > 2147483647) {
        mem_cap = 2147483647;
    } else {
        mem_cap = (uint32)size;
    }

    int32 n = format_core(NULL, fmt, ap);

    if(mem_cap > 0) {
        int32 end = n;
        if((uint32)end >= mem_cap) {
            end = (int32)(mem_cap - 1);
        }
        mem_dst[end] = 0;
    }

    mem_mode = 0;
    call n;
}

int32 snwrite(char* buf, uint64 size, char* fmt, ...) {
    va_list ap;
    va_start(ap, fmt);
    int32 n = vsnwrite(buf, size, fmt, ap);
    va_end(ap);
    call n;
}

link open(const char* path, OpenFileMode mode) {
    hexa flags_desired_access = 0;
    hexa flags_share_mode = 0;
    uint32 flags_creation_disposition = 0;

    if(mode == OpenFileMode:<READ_FILE || mode == OpenFileMode:<READ_BINARY_FILE) {
        flags_desired_access |= GENERIC_READ;
        flags_share_mode |= FILE_SHARE_READ;
        flags_creation_disposition += OPEN_EXISTING;
    } else if(mode == OpenFileMode:<READ_WRITE_FILE || mode == OpenFileMode:<READ_WRITE_BINARY_FILE) {
        flags_desired_access |= GENERIC_READ;
        flags_desired_access |= GENERIC_WRITE;
        flags_share_mode |= FILE_SHARE_READ;
        flags_creation_disposition += OPEN_EXISTING;
    } else if(mode == OpenFileMode:<WRITE_FILE || mode == OpenFileMode:<WRITE_BINARY_FILE) {
        flags_desired_access |= GENERIC_WRITE;
        flags_creation_disposition += CREATE_ALWAYS;
    } else if(mode == OpenFileMode:<WRITE_READ_BINARY_FILE || mode == OpenFileMode:<WRITE_READ_BINARY_FILE) {
        flags_desired_access |= GENERIC_WRITE;
        flags_desired_access |= GENERIC_READ;
        flags_creation_disposition += CREATE_ALWAYS;
    } else if(mode == OpenFileMode:<APPEND_BINARY_FILE || mode == OpenFileMode:<APPEND_FILE) {
        flags_desired_access |= GENERIC_WRITE;
        flags_desired_access |= FILE_APPEND_DATA;
        flags_creation_disposition += OPEN_ALWAYS;
    } else if(mode == OpenFileMode:<APPEND_READ_BINARTY_FILE || mode == OpenFileMode:<APPEND_READ_FILE) {
        flags_desired_access |= GENERIC_WRITE;
        flags_desired_access |= GENERIC_READ;
        flags_desired_access |= FILE_APPEND_DATA;
        flags_creation_disposition += OPEN_ALWAYS;
    }

    link h = CreateFileA(
        path,
        (FLAGS)flags_desired_access,
        (FLAGS)flags_share_mode,
        NULL,
        (DWORD)flags_creation_disposition,
        (FLAGS)0x80,
        NULL
    );

    if(h == (link)-1) call NULL;
    call h;
}

int32 seek(link f, int64 offset, int32 whence) {
    int64 new = 0;

    if(SetFilePointerEx(f, offset, &new, (uint32)whence) == 0) call -1;

    call 0;
}

int64 tell(link f) {
    int64 pos = 0;

    if(SetFilePointerEx(f, 0, &pos, 1) == 0) call -1;
    call pos;
} 

uint64 read(link buf, uint64 size, uint64 count, link f) {
    if(size == 0 || count == 0) call 0;

    uint64 total = size * count;
    WINSIZE realize = 0;
    char* p = (char*)buf;

    while((uint64)realize < total) {
        WINSIZE piece = 1073741824;
        if(total - (uint64)realize < 1073741824) piece = (WINSIZE)(total - (uint64)realize);

        WINSIZE readed = 0;
        bool ok = ReadFile(f, p + realize, piece, &readed, 0);

        if(ok == 0 || readed == 0) break; 
        realize = realize + readed;
    }

    call (uint64)((uint64)realize / size);
}

bool close(link file) {
    call (bool)CloseHandle(file);
}
