}

int32 wmemcmp(link a, link b, uint64 count) {
    uint64 n = count << 1;

    if(n >= 16) {
        uint8* p = (uint8*)a;
        uint8* q = (uint8*)b;
        uint8* pl = p + (n - 16);
        uint8* ql = q + (n - 16);
        while(p < pl) {
            uint32 m = __vdiff16(p, q);
            if(m != 0) {
                call wdiff_at(p, q, __ctz(m) >> 1);
            }
            p = p + 16;
            q = q + 16;
        }
        uint32 t = __vdiff16(pl, ql);
        if(t != 0) {
            call wdiff_at(pl, ql, __ctz(t) >> 1);
        }
        call 0;
    }

    uint16* x = (uint16*)a;
    uint16* y = (uint16*)b;
    for(uint64 i = 0; i < count; ++i) {
        if(x[i] != y[i]) {
            call (int32)x[i] - (int32)y[i];
        }
    }
    call 0;
}

link wmemchr(link s, uint16 w, uint64 count) {
    uint64 n = count << 1;

    if(n >= 16) {
        uint8* p = (uint8*)s;
        uint64 v = (uint64)w * (uint64)0x0001000100010001;
        uint8* pl = p + (n - 16);
        while(p < pl) {
            uint32 m = __vfindw16(p, v);
            if(m != 0) {
                call (link)(p + __ctz(m));
            }
            p = p + 16;
        }
        uint32 t = __vfindw16(pl, v);
        if(t != 0) {
            call (link)(pl + __ctz(t));
        }
        call NULL;
    }

    uint16* q = (uint16*)s;
    for(uint64 i = 0; i < count; ++i) {
        if(q[i] == w) {
            call (link)(q + i);
        }
    }
    call NULL;
}
