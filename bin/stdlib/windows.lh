extern bool PathRemoveExtensionW(WINWCHAR* path);
extern bool PathRenameExtensionA(WINCHAR* path, const WINCHAR* extension);
extern bool PathRenameExtensionW(WINWCHAR* path, const WINWCHAR* extension);
extern bool PathAddExtensionA(WINCHAR* path, const WINCHAR* extension);
extern bool PathAddExtensionW(WINWCHAR* path, const WINWCHAR* extension);
extern WINCHAR* PathAddBackslashA(WINCHAR* path);
extern WINWCHAR* PathAddBackslashW(WINWCHAR* path);
extern WINCHAR* PathRemoveBackslashA(WINCHAR* path);
extern WINWCHAR* PathRemoveBackslashW(WINWCHAR* path);
extern WINCHAR* PathSkipRootA(const WINCHAR* path);
extern WINWCHAR* PathSkipRootW(const WINWCHAR* path);
extern void PathUnquoteSpacesA(WINCHAR* path);
extern void PathUnquoteSpacesW(WINWCHAR* path);
extern int32 PathCommonPrefixA(const WINCHAR* file1, const WINCHAR* file2, WINCHAR* path);
extern int32 PathCommonPrefixW(const WINWCHAR* file1, const WINWCHAR* file2, WINWCHAR* path);
extern bool PathRelativePathToA(WINCHAR* path, WINCHAR* from, DWORD attributes_from, WINCHAR* to, DWORD attributes_to);
extern bool PathRelativePathToW(WINWCHAR* path, WINWCHAR* from, DWORD attributes_from, WINWCHAR* to, DWORD attributes_to);
