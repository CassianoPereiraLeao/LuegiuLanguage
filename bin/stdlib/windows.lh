use target -> single

extract -> [kernel32]
extract -> [user32]
extract -> [gdi32]
extract -> [bool.lh]

preprocess NULL -> (link)0
preprocess PATH_MAX -> 4096

newtype uint16 WORD;
newtype uint64 WINSIZE;
newtype uint32 DWORD;
newtype hexa FLAGS;
newtype uint32 WINUINT32;
newtype utfchar WINWCHAR;
newtype char WINCHAR;

newtype data {
    int32 unused;
} HINSTANCE__;

extern DWORD GetModuleFileNameA(HINSTANCE__* module, WINCHAR* filename, WINSIZE size);
extern DWORD GetModuleFileNameW(HINSTANCE__* module, WINWCHAR* filename, WINSIZE size);
extern link fileno(int32 fd);
extern int32 __isatty(link h);
extern utfchar* getenv(utfchar* name);
extern WINWCHAR* GetEnvironmentStringsW();
extern DWORD GetFullPathNameA(const WINCHAR* filename, WINSIZE buffer_len, WINCHAR* buffer, WINCHAR file_part);
extern DWORD GetFullPathNameW(const WINWCHAR* filename, WINSIZE buffer_len, WINWCHAR* buffer, WINWCHAR** file_part);
extern DWORD GetEnvironmentVariableA(const WINCHAR* name, WINCHAR* buffer, WINSIZE size);
extern DWORD GetEnvironmentVariableW(const WINWCHAR* name, WINWCHAR* buffer, WINSIZE size);
extern void SetLastError(DWORD code);
extern bool SetEndOfFile(link file);
extern DWORD GetFileSize(link file, int64* file_size);
extern bool GetFileSizeEx(link file, int64* file_size);
extern DWORD SetFilePointer(link file, int32 distance, int32* distance_to_move, DWORD method);
extern bool SetFilePointerEx(link file, int64 distance, int64* new_file_ptr, DWORD method);
