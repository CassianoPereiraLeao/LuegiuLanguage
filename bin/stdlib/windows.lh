extern bool PathSearchAndQualifyW(WINWCHAR* path, WINWCHAR* buffer, WINUINT32 buffer_len);
extern bool PathUnExpandEnvStringsA(WINCHAR* path, WINCHAR* buffer, WINUINT32 buffer_len);
extern bool PathUnExpandEnvStringsW(WINWCHAR* path, WINWCHAR* buffer, WINUINT32 buffer_len);
extern bool PathMakePrettyA(WINCHAR* path);
extern bool PathMakePrettyW(WINWCHAR* path);
extern void PathUndecorateA(WINCHAR* path);
extern void PathUndecorateW(WINWCHAR* path);
