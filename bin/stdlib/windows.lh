extern link GetStdHandle(DWORD fd);
extern bool WriteFile(link file, link buffer, DWORD len, DWORD* written, link overlapped);
extern bool ReadFile(link file, link buffer, DWORD bytes_to_read, DWORD* readed, link overlapped);
extern bool WriteConsoleA(link console, link buffer, DWORD char_to_write, DWORD* written, link reserved);
extern bool ReadConsoleA(link console, link buffer, DWORD char_to_write, DWORD* written, link input_control);
extern link CreateFileA(char* file_name, FLAGS desired_access, FLAGS share_mode, link security_attributes, DWORD create_disposition, FLAGS attributes, link template);
