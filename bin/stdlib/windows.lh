extern WINWCHAR* PathCombineW(WINWCHAR* dest, const WINWCHAR* dir, const WINWCHAR* file);
extern bool PathAppendA(WINCHAR* path, const WINCHAR* append);
extern bool PathAppendW(WINWCHAR* path, const WINWCHAR* append);
extern bool PathCanonicalizeA(WINCHAR* buffer, const WINCHAR* path);
extern bool PathCanonicalizeW(WINWCHAR* buffer, const WINWCHAR* path);
