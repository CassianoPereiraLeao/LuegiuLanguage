int32 testar_operadores() {
    int32 a = 10 + 5 - 2 * 3 / 2;
    int32 b = 10 % 3;
    
    int32 c = (1 << 4) >> 2;
    int32 d = 0x0F & 0x03;
    int32 e = 0x0F | 0xF0;
    int32 f = 0xAA ^ 0x55;
    int32 g = ~0;

    int32 cond = (a > b) && (c <= d) || (e == f) && !(g != 0);
    
    a += 5;
    b -= 1;
    c *= 2;
    d /= 2;

    call a;
}